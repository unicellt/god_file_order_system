      "filePath": "order_system.py",
      "summary": "单文件订单系统，包含结算、库存、风控、持久化、报表、支付、通知和大量兼容入口。",
      "tags": ["god-file", "python", "订单系统"]
    },
    {
      "id": "module:public-api",
      "type": "module",
      "name": "Public API / 调用入口",
      "summary": "真实调用面包括 dispatch_checkout、OrderSystem、CheckoutFacade、旧 calc 入口、报价入口、后台服务和全局对象。",
      "tags": ["入口", "兼容面", "下游依赖"]
    },
    {
      "id": "function:order_system.py:dispatch_checkout",
      "type": "function",
      "name": "dispatch_checkout",
      "filePath": "order_system.py",
      "summary": "对外统一下单入口，受 use_legacy_v1 feature flag 控制，可能返回两种结构。",
      "tags": ["入口", "feature-flag", "返回结构分叉"]
    },
    {
      "id": "class:order_system.py:OrderSystem",
      "type": "class",
      "name": "OrderSystem",
      "filePath": "order_system.py",
      "summary": "核心 god class，checkout 将计价、折扣、税费、积分、风控、库存、落库和通知串在一起。",
      "tags": ["核心链路", "god-class", "副作用集中"]
    },
    {
      "id": "function:order_system.py:OrderSystem.checkout",
      "type": "function",
      "name": "OrderSystem.checkout",
      "filePath": "order_system.py",
      "summary": "正式下单结算路径，返回订单 dict，同时推进订单号、更新会话、扣库存、写库、写事件、改 user 积分。",
      "tags": ["主链路", "结算", "隐式输出"]
    },
    {
      "id": "module:legacy-calculators",
      "type": "module",
      "name": "旧结算入口",
      "summary": "calc_v0、calc_v1、calc_v2、legacy_calc、get_price、quick_total 等兼容函数仍可能被报表和老批处理调用。",
      "tags": ["旧实现", "兼容层", "多口径"]
    },
    {
      "id": "module:quote-reconcile",
      "type": "module",
      "name": "报价 / 对账实现",
      "summary": "quote、PriceQuoteBuilder、checkout_v3_experimental、RegionalSettlement 和 SettlementReconciler 都能算价但口径不同。",
      "tags": ["报价", "对账", "多套实现"]
    },
    {
      "id": "module:validation-config-ops",
      "type": "module",
      "name": "校验 / 配置 / 运营",
      "summary": "CartValidator、ConfigManager、CouponIssuer、InventoryAdmin、GiftCardService、LoyaltyManager 等后台入口会修改全局状态或传入对象。",
      "tags": ["后台", "配置", "可变全局"]
    },
    {
      "id": "module:inventory-fulfillment",
      "type": "module",
      "name": "库存 / 仓配",
      "summary": "OrderSystem.reserve/release、InventoryAdmin、WarehouseRouter、InventoryForecast、ShippingLabelPrinter 等共同处理库存和发货。",
      "tags": ["库存", "仓配", "副作用"]
    },
    {
      "id": "module:tax-shipping",
      "type": "module",
      "name": "税 / 运费",
      "summary": "checkout 粗税粗运费与 TaxCalculator、ShippingCalculator、RegionalSettlement 的细口径并存。",
      "tags": ["税", "运费", "规则分叉"]
    },
    {
      "id": "module:promo-coupon-gift",
      "type": "module",
      "name": "促销 / 券 / 礼品卡",
      "summary": "COUPON_CATALOG、checkout coupon 分支、PromoEngine、CouponIssuer、GiftCardService、BundleCatalog、GiftWrapService 形成多套优惠体系。",
      "tags": ["促销", "优惠券", "礼品卡"]
    },
    {
      "id": "module:risk",
      "type": "module",
      "name": "风控",
      "summary": "OrderSystem.risk_score 是主链路分数，ExtRiskEngine 是解释型扩展分数，两套口径不同。",
      "tags": ["风控", "拒单", "规则分叉"]
    },
    {
      "id": "module:payment-after-sale",
      "type": "module",
      "name": "支付 / 售后 / 状态",
      "summary": "PaymentSimulator、RefundEngine、DisputeCenter、OrderStateMachine 处理支付、退款、争议和状态，但 checkout 直接写状态字符串。",
      "tags": ["支付", "退款", "状态机"]
    },
    {
      "id": "module:report-notify-display",
      "type": "module",
      "name": "报表 / 通知 / 展示",
      "summary": "OrderSystem.notify、NotificationDispatcher、ReportBuilder、Analytics、TaxFilingReport、ReceiptPrinter 等从订单和事件流读取不同口径。",
      "tags": ["报表", "通知", "展示"]
    },
